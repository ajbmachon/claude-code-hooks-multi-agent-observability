# Maximum number of events to display in the client
# When more events are received via WebSocket, the oldest events will be removed
VITE_MAX_EVENTS_TO_DISPLAY=300

# Defaults assume the server is running on the non-hub observability port.
VITE_OBSERVABILITY_API_URL=http://localhost:4005
VITE_OBSERVABILITY_WS_URL=ws://localhost:4005/stream
